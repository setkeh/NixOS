input {
    // Omitting touchpad settings disables them, or leaves them at their default values.
    touchpad {
        off
    }

    mouse {
        // Disable acceleration.
        accel-profile "flat"

        // Faster scrolling with the mouse wheel.
        scroll-factor 2.0
    }

    // Uncomment this to make the mouse warp to the center of newly focused windows.
    // warp-mouse-to-focus

    // Focus windows and outputs automatically when moving the mouse into them.
    // focus-follows-mouse
}

output "DP-1" {
position x=0 y=0
}

// Setup Workspaces For Display DP-2
workspace "Shell" {
    open-on-output "DP-1"
}
workspace "Agents" {
    open-on-output "DP-1"
}
workspace "ADE-Devel" {
    open-on-output "DP-1"
}
workspace "OzRust Devel" {
    open-on-output "DP-1"
}
workspace "Audio" {
    open-on-output "DP-1"
}
workspace "Gaming" {
    open-on-output "DP-1"
}

// Setup Workspaces For Display HDMI-A-1
workspace "Browsers" {
    open-on-output "HDMI-A-1"
}
workspace "Chat" {
    open-on-output "HDMI-A-1"
}
workspace "Secret" {
    open-on-output "HDMI-A-1"
}

prefer-no-csd

spawn-sh-at-startup "swaybg -m fill -i ~/.config/wallpapers/space-planet-science-night-generated-by-ai.jpg"
spawn-at-startup "waybar"

//Window Rules

// Commands to get window details
// niri msg pick-window      # then click the window you want
// niri msg focused-window   # the window that currently has focus
// niri msg windows          # every window with its ID, title and app ID

// Secrets Management
window-rule {
    match app-id="1password"
    block-out-from "screen-capture"
    open-on-workspace "Secret"
    opacity 0.75
}

// Browsers
window-rule {
    match app-id="vivaldi-stable"
    open-on-workspace "Browsers"
    opacity 1.0
}

window-rule {
    match title="Picture-in-Picture"
    match app-id="firefox"
    block-out-from "screencast"
    open-on-output "DP-2"
    default-column-width { proportion 0.5; }
    opacity 1.0
}

// Chat Apps 
window-rule {
    match app-id="discord"
    open-on-workspace "Chat"
    opacity 0.75
}

// Games
window-rule {
    match app-id="steam_app_default"
    opacity 1.0
    open-floating false
}

window-rule {
    match app-id="com.moonlight_stream.Moonlight"
    open-on-workspace "Gaming"
}

// Image viewing
window-rule {
    match app-id="swayimg"
    opacity 1.0
    open-floating false
}

window-rule {
    match app-id="org.kde.digikam"
    opacity 1.0
    open-floating false
}

binds {
    Mod+Space repeat=false hotkey-overlay-title="Aegis talk" {
        spawn "/home/setkeh/Development/Aegis-AIOS/app/build/linux/x64/debug/bundle/aegis_shell" "--toggle-hud";
    }

    // Allow Reordering Workspaces
    Mod+Shift+Down { move-workspace-down; }
    Mod+Shift+Up   { move-workspace-up; }
}
