--- /dev/null
+++ b/wayvr/src/subsystem/hid/physical.rs
@@ -0,0 +1,584 @@
+//! Physical keyboard passthrough for native WayVR windows.
+//!
+//! Native apps launched by WayVR live in WayVR's built-in Wayland compositor,
+//! which otherwise only receives keys from the in-VR keyboard. When enabled
+//! (`physical_keyboard: true`), this module:
+//!
+//! - Grabs every physical keyboard exclusively (`EVIOCGRAB`) while keyboard
+//!   focus is on a WayVR window, and forwards its keys into the compositor.
+//!   The desktop compositor sees nothing while the grab is held.
+//! - Releases the grab and hands focus back to the desktop when you click any
+//!   physical mouse button, i.e. when you click into a window on a real display.
+//! - Toggles focus between desktop and WayVR with Ctrl+Alt+Escape.
+//!
+//! With `physical_mouse: true` as well, physical mice are grabbed alongside the
+//! keyboards and their motion, buttons and wheel are queued for the focused
+//! WayVR window (see `WvrWindowBackend::apply_physical_mouse`). A mouse click
+//! then no longer returns focus to the desktop; use Ctrl+Alt+Escape.
+//!
+//! Focus is entered via the existing paths too: clicking a WayVR window with a
+//! controller sets `KeyboardFocus::WayVR` as before.
+//!
+//! Needs read access to `/dev/input/event*` (the `input` group).
+
+use std::{
+    collections::BTreeSet,
+    fs::{File, OpenOptions},
+    io::ErrorKind,
+    os::unix::fs::OpenOptionsExt,
+    path::{Path, PathBuf},
+    time::{Duration, Instant},
+};
+
+use input_linux::{AbsoluteAxis, EvdevHandle, Key, RelativeAxis, sys::input_event};
+
+use crate::{backend::wayvr::WvrServerState, subsystem::input::KeyboardFocus};
+
+const EV_KEY: u16 = 0x01;
+const EV_REL: u16 = 0x02;
+const REL_X: u16 = 0x00;
+const REL_Y: u16 = 0x01;
+const REL_HWHEEL: u16 = 0x06;
+const REL_WHEEL: u16 = 0x08;
+/// One wheel detent in WayVR's `WheelDelta` units: `send_pointer_axis_wheel`
+/// multiplies by 32 and emits a discrete step every 120.
+const WHEEL_NOTCH: f32 = 120.0 / 32.0;
+/// evdev keycode -> XKB keycode, matching `VirtualKey` and `WvrServerState::send_key`.
+const XKB_OFFSET: u32 = 8;
+const RESCAN_INTERVAL: Duration = Duration::from_secs(3);
+/// Devices created by WayVR itself (uinput provider). Never grab or watch these,
+/// or controller clicks would immediately release the grab.
+const OWN_DEVICE_PREFIX: &[u8] = b"WayVR";
+
+const KEY_ESC: u16 = Key::Esc as u16;
+const KEY_LEFTCTRL: u16 = Key::LeftCtrl as u16;
+const KEY_RIGHTCTRL: u16 = Key::RightCtrl as u16;
+const KEY_LEFTALT: u16 = Key::LeftAlt as u16;
+const KEY_RIGHTALT: u16 = Key::RightAlt as u16;
+const BTN_LEFT: u16 = Key::ButtonLeft as u16;
+const BTN_RIGHT: u16 = Key::ButtonRight as u16;
+const BTN_MIDDLE: u16 = Key::ButtonMiddle as u16;
+
+/// Where forwarded keys go. Implemented by the WayVR compositor; a trait so the
+/// routing logic can be unit-tested without one.
+trait KeySink {
+    fn send_key(&mut self, xkb_keycode: u32, down: bool);
+}
+
+impl KeySink for WvrServerState {
+    fn send_key(&mut self, xkb_keycode: u32, down: bool) {
+        Self::send_key(self, xkb_keycode, down);
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum PhysicalButton {
+    Left,
+    Middle,
+    Right,
+}
+
+/// Physical mouse input destined for the focused WayVR window.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub enum PhysicalMouseEvent {
+    /// Relative motion in device units (treated as window pixels, 1:1).
+    Motion { dx: f32, dy: f32 },
+    Button { button: PhysicalButton, pressed: bool },
+    /// In `WheelDelta` units; positive y scrolls up, positive x scrolls right.
+    Wheel { x: f32, y: f32 },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum DevKind {
+    Keyboard,
+    Mouse,
+}
+
+struct Device {
+    path: PathBuf,
+    name: String,
+    kind: DevKind,
+    handle: EvdevHandle<File>,
+    grabbed: bool,
+}
+
+pub struct PhysicalKeyboard {
+    devices: Vec<Device>,
+    last_scan: Option<Instant>,
+    /// evdev codes currently held down on any keyboard (forwarded or not).
+    held: BTreeSet<u16>,
+    /// evdev codes we sent as "pressed" into WayVR and still owe a release for.
+    forwarded: BTreeSet<u16>,
+    warned_permissions: bool,
+    /// Forward physical mice into WayVR instead of using clicks to leave it.
+    forward_mouse: bool,
+    /// Mouse buttons pressed inside WayVR that still owe a release.
+    mouse_held: Vec<PhysicalButton>,
+    /// Filled by `poll`, drained by the focused window's overlay each frame.
+    mouse_events: Vec<PhysicalMouseEvent>,
+}
+
+impl PhysicalKeyboard {
+    pub fn new(forward_mouse: bool) -> Self {
+        log::info!(
+            "Physical keyboard passthrough enabled{} (toggle: Ctrl+Alt+Escape)",
+            if forward_mouse { ", with mouse" } else { "" }
+        );
+        Self {
+            devices: Vec::new(),
+            last_scan: None,
+            held: BTreeSet::new(),
+            forwarded: BTreeSet::new(),
+            warned_permissions: false,
+            forward_mouse,
+            mouse_held: Vec::new(),
+            mouse_events: Vec::new(),
+        }
+    }
+
+    /// Mouse events gathered by the last `poll`. Called by the overlay of the
+    /// WayVR window that has keyboard focus.
+    pub fn take_mouse_events(&mut self) -> Vec<PhysicalMouseEvent> {
+        std::mem::take(&mut self.mouse_events)
+    }
+
+    /// Call once per frame.
+    pub fn poll(&mut self, focus: &mut KeyboardFocus, mut wvr: Option<&mut WvrServerState>) {
+        // Anything not consumed last frame (e.g. focused window hidden) is stale.
+        self.mouse_events.clear();
+        self.rescan_if_due();
+
+        let mut events = [unsafe { std::mem::zeroed::<input_event>() }; 64];
+        let mut dead = Vec::new();
+
+        for idx in 0..self.devices.len() {
+            loop {
+                let n = match self.devices[idx].handle.read(&mut events) {
+                    Ok(0) => break,
+                    Ok(n) => n,
+                    Err(e) if e.kind() == ErrorKind::WouldBlock => break,
+                    Err(e) => {
+                        log::info!("Input device {} gone: {e}", self.devices[idx].name);
+                        dead.push(idx);
+                        break;
+                    }
+                };
+
+                let kind = self.devices[idx].kind;
+                for ev in &events[..n] {
+                    match kind {
+                        DevKind::Mouse => {
+                            if self.handle_mouse(ev.type_, ev.code, ev.value, *focus) {
+                                log::debug!("Physical mouse click: keyboard focus -> desktop");
+                                self.release_all(wvr.as_deref_mut());
+                                *focus = KeyboardFocus::PhysicalScreen;
+                            }
+                        }
+                        DevKind::Keyboard => {
+                            if ev.type_ != EV_KEY || ev.value == 2 {
+                                continue; // press/release only; clients do their own key repeat
+                            }
+                            let was_wayvr = *focus == KeyboardFocus::WayVR;
+                            self.handle_key(ev.code, ev.value == 1, focus, wvr.as_deref_mut());
+                            if was_wayvr && *focus != KeyboardFocus::WayVR {
+                                self.release_mouse_buttons();
+                            }
+                        }
+                    }
+                }
+            }
+        }
+
+        for idx in dead.into_iter().rev() {
+            self.devices.remove(idx);
+        }
+
+        // Grab exactly while WayVR has focus and its compositor exists.
+        let want_grab = *focus == KeyboardFocus::WayVR && wvr.is_some();
+        if !want_grab && !self.forwarded.is_empty() {
+            self.release_all(wvr);
+        }
+        let forward_mouse = self.forward_mouse;
+        for (dev, want) in self.devices.iter_mut().filter_map(|d| {
+            let want = match d.kind {
+                DevKind::Keyboard => want_grab,
+                DevKind::Mouse => want_grab && forward_mouse,
+            };
+            (d.grabbed != want).then_some((d, want))
+        }) {
+            let want_grab = want;
+            match dev.handle.grab(want_grab) {
+                Ok(()) => {
+                    dev.grabbed = want_grab;
+                    log::debug!(
+                        "{} {}",
+                        if want_grab { "Grabbed" } else { "Released" },
+                        dev.name
+                    );
+                }
+                Err(e) => log::warn!("Could not change grab on {}: {e}", dev.name),
+            }
+        }
+    }
+
+    /// Handle one event from a physical mouse. Returns true when the event
+    /// should hand keyboard focus back to the desktop.
+    fn handle_mouse(&mut self, type_: u16, code: u16, value: i32, focus: KeyboardFocus) -> bool {
+        if focus != KeyboardFocus::WayVR {
+            return false; // not grabbed: the desktop already received this
+        }
+
+        let button = match code {
+            BTN_LEFT => Some(PhysicalButton::Left),
+            BTN_RIGHT => Some(PhysicalButton::Right),
+            BTN_MIDDLE => Some(PhysicalButton::Middle),
+            _ => None,
+        };
+
+        if !self.forward_mouse {
+            // Keyboard-only mode: a click means "I'm back on the desktop".
+            return type_ == EV_KEY && value == 1 && button.is_some();
+        }
+
+        match (type_, code) {
+            (EV_KEY, _) if value != 2 => {
+                let Some(button) = button else { return false };
+                let pressed = value == 1;
+                if pressed {
+                    self.mouse_held.push(button);
+                } else if let Some(i) = self.mouse_held.iter().position(|b| *b == button) {
+                    self.mouse_held.remove(i);
+                } else {
+                    return false; // pressed before the grab: never sent to WayVR
+                }
+                self.mouse_events.push(PhysicalMouseEvent::Button { button, pressed });
+            }
+            (EV_REL, REL_X | REL_Y) => {
+                #[allow(clippy::cast_precision_loss)]
+                let d = value as f32;
+                let (dx, dy) = if code == REL_X { (d, 0.0) } else { (0.0, d) };
+                // Coalesce with a trailing motion event so one frame = one move.
+                if let Some(PhysicalMouseEvent::Motion { dx: px, dy: py }) =
+                    self.mouse_events.last_mut()
+                {
+                    *px += dx;
+                    *py += dy;
+                } else {
+                    self.mouse_events.push(PhysicalMouseEvent::Motion { dx, dy });
+                }
+            }
+            (EV_REL, REL_WHEEL | REL_HWHEEL) => {
+                #[allow(clippy::cast_precision_loss)]
+                let notches = value as f32 * WHEEL_NOTCH;
+                let (x, y) = if code == REL_WHEEL { (0.0, notches) } else { (notches, 0.0) };
+                self.mouse_events.push(PhysicalMouseEvent::Wheel { x, y });
+            }
+            _ => {}
+        }
+        false
+    }
+
+    /// Queue releases for any mouse buttons held inside WayVR, so nothing
+    /// stays stuck down when focus leaves.
+    fn release_mouse_buttons(&mut self) {
+        for button in std::mem::take(&mut self.mouse_held) {
+            self.mouse_events.push(PhysicalMouseEvent::Button { button, pressed: false });
+        }
+    }
+
+    fn handle_key<K: KeySink>(
+        &mut self,
+        code: u16,
+        down: bool,
+        focus: &mut KeyboardFocus,
+        wvr: Option<&mut K>,
+    ) {
+        if down {
+            self.held.insert(code);
+        } else {
+            self.held.remove(&code);
+        }
+
+        // Ctrl+Alt+Escape toggles focus. The Escape press is swallowed.
+        if down && code == KEY_ESC && self.ctrl_held() && self.alt_held() {
+            match *focus {
+                KeyboardFocus::WayVR => {
+                    log::info!("Ctrl+Alt+Escape: keyboard -> desktop");
+                    self.release_all(wvr);
+                    *focus = KeyboardFocus::PhysicalScreen;
+                }
+                KeyboardFocus::PhysicalScreen if wvr.is_some() => {
+                    log::info!("Ctrl+Alt+Escape: keyboard -> WayVR");
+                    *focus = KeyboardFocus::WayVR;
+                    // Ctrl and Alt are physically down but the desktop saw them
+                    // pressed, not WayVR. Don't forward them until re-pressed.
+                }
+                KeyboardFocus::PhysicalScreen => {}
+            }
+            return;
+        }
+
+        if *focus != KeyboardFocus::WayVR {
+            return; // not grabbed: the desktop already received this key
+        }
+        let Some(wvr) = wvr else { return };
+
+        if down {
+            self.forwarded.insert(code);
+            wvr.send_key(u32::from(code) + XKB_OFFSET, true);
+        } else if self.forwarded.remove(&code) {
+            // Only release what we pressed, so keys held across the focus
+            // switch don't produce a stray release in the VR app.
+            wvr.send_key(u32::from(code) + XKB_OFFSET, false);
+        }
+    }
+
+    /// Release every key we pressed inside WayVR, so nothing gets stuck down
+    /// when focus leaves.
+    fn release_all<K: KeySink>(&mut self, wvr: Option<&mut K>) {
+        let forwarded = std::mem::take(&mut self.forwarded);
+        if let Some(wvr) = wvr {
+            for code in forwarded {
+                wvr.send_key(u32::from(code) + XKB_OFFSET, false);
+            }
+        }
+    }
+
+    fn ctrl_held(&self) -> bool {
+        self.held.contains(&KEY_LEFTCTRL) || self.held.contains(&KEY_RIGHTCTRL)
+    }
+
+    fn alt_held(&self) -> bool {
+        self.held.contains(&KEY_LEFTALT) || self.held.contains(&KEY_RIGHTALT)
+    }
+
+    fn rescan_if_due(&mut self) {
+        let now = Instant::now();
+        if self
+            .last_scan
+            .is_some_and(|t| now.duration_since(t) < RESCAN_INTERVAL)
+        {
+            return;
+        }
+        self.last_scan = Some(now);
+
+        let Ok(dir) = std::fs::read_dir("/dev/input") else {
+            return;
+        };
+        let mut denied = 0;
+        for entry in dir.flatten() {
+            let path = entry.path();
+            let is_event_node = path
+                .file_name()
+                .and_then(|n| n.to_str())
+                .is_some_and(|n| n.starts_with("event"));
+            if !is_event_node || self.devices.iter().any(|d| d.path == path) {
+                continue;
+            }
+            match open_device(&path) {
+                Ok(Some(dev)) => {
+                    log::info!("Physical {:?}: {} ({})", dev.kind, dev.name, path.display());
+                    self.devices.push(dev);
+                }
+                Ok(None) => {}
+                Err(e) if e.kind() == ErrorKind::PermissionDenied => denied += 1,
+                Err(e) => log::debug!("Skipping {}: {e}", path.display()),
+            }
+        }
+        if denied > 0 && self.devices.is_empty() && !self.warned_permissions {
+            self.warned_permissions = true;
+            log::warn!(
+                "Physical keyboard passthrough: no access to /dev/input/event* \
+                 ({denied} denied). Add your user to the 'input' group."
+            );
+        }
+    }
+}
+
+/// Open and classify an evdev node. `Ok(None)` = not a keyboard or mouse we care about.
+fn open_device(path: &Path) -> std::io::Result<Option<Device>> {
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NONBLOCK | libc::O_CLOEXEC)
+        .open(path)?;
+    let handle = EvdevHandle::new(file);
+
+    let raw_name = handle.device_name().unwrap_or_default();
+    if raw_name.starts_with(OWN_DEVICE_PREFIX) {
+        return Ok(None);
+    }
+    let name = String::from_utf8_lossy(&raw_name)
+        .trim_end_matches('\0')
+        .to_string();
+
+    let keys = handle.key_bits()?;
+    let is_keyboard = keys.get(Key::A) && keys.get(Key::Z) && keys.get(Key::Space);
+    // Mice report relative motion; touchpads report absolute.
+    let is_mouse = !is_keyboard
+        && keys.get(Key::ButtonLeft)
+        && (handle
+            .relative_bits()
+            .is_ok_and(|rel| rel.get(RelativeAxis::X) && rel.get(RelativeAxis::Y))
+            || handle
+                .absolute_bits()
+                .is_ok_and(|abs| abs.get(AbsoluteAxis::X) && abs.get(AbsoluteAxis::Y)));
+
+    let kind = if is_keyboard {
+        DevKind::Keyboard
+    } else if is_mouse {
+        DevKind::Mouse
+    } else {
+        return Ok(None);
+    };
+
+    Ok(Some(Device {
+        path: path.to_path_buf(),
+        name,
+        kind,
+        handle,
+        grabbed: false,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const A: u16 = Key::A as u16;
+
+    #[derive(Default)]
+    struct Recorder(Vec<(u32, bool)>);
+
+    impl KeySink for Recorder {
+        fn send_key(&mut self, xkb_keycode: u32, down: bool) {
+            self.0.push((xkb_keycode, down));
+        }
+    }
+
+    impl Recorder {
+        fn recorded_keys(&self) -> &[(u32, bool)] {
+            &self.0
+        }
+    }
+
+    fn test_server() -> Recorder {
+        Recorder::default()
+    }
+
+    #[test]
+    fn forwards_keys_with_xkb_offset_while_focused() {
+        let mut pk = PhysicalKeyboard::new(false);
+        let mut focus = KeyboardFocus::WayVR;
+        let mut wvr = test_server();
+        pk.handle_key(A, true, &mut focus, Some(&mut wvr));
+        pk.handle_key(A, false, &mut focus, Some(&mut wvr));
+        assert_eq!(wvr.recorded_keys(), [(u32::from(A) + 8, true), (u32::from(A) + 8, false)]);
+    }
+
+    #[test]
+    fn ignores_keys_while_desktop_has_focus() {
+        let mut pk = PhysicalKeyboard::new(false);
+        let mut focus = KeyboardFocus::PhysicalScreen;
+        let mut wvr = test_server();
+        pk.handle_key(A, true, &mut focus, Some(&mut wvr));
+        assert!(wvr.recorded_keys().is_empty());
+    }
+
+    #[test]
+    fn chord_releases_held_keys_and_returns_focus_to_desktop() {
+        let mut pk = PhysicalKeyboard::new(false);
+        let mut focus = KeyboardFocus::WayVR;
+        let mut wvr = test_server();
+        pk.handle_key(KEY_LEFTCTRL, true, &mut focus, Some(&mut wvr));
+        pk.handle_key(KEY_LEFTALT, true, &mut focus, Some(&mut wvr));
+        pk.handle_key(KEY_ESC, true, &mut focus, Some(&mut wvr));
+        assert_eq!(focus, KeyboardFocus::PhysicalScreen);
+        let sent = wvr.recorded_keys();
+        // Ctrl + Alt pressed, then both released; Escape never reaches the app.
+        assert_eq!(sent.iter().filter(|(_, d)| *d).count(), 2);
+        assert_eq!(sent.iter().filter(|(_, d)| !*d).count(), 2);
+        assert!(!sent.iter().any(|(k, _)| *k == u32::from(KEY_ESC) + 8));
+    }
+
+    #[test]
+    fn chord_from_desktop_enters_wayvr_without_stray_releases() {
+        let mut pk = PhysicalKeyboard::new(false);
+        let mut focus = KeyboardFocus::PhysicalScreen;
+        let mut wvr = test_server();
+        pk.handle_key(KEY_LEFTCTRL, true, &mut focus, Some(&mut wvr));
+        pk.handle_key(KEY_LEFTALT, true, &mut focus, Some(&mut wvr));
+        pk.handle_key(KEY_ESC, true, &mut focus, Some(&mut wvr));
+        assert_eq!(focus, KeyboardFocus::WayVR);
+        // Releasing modifiers the app never saw pressed must not be forwarded.
+        pk.handle_key(KEY_ESC, false, &mut focus, Some(&mut wvr));
+        pk.handle_key(KEY_LEFTALT, false, &mut focus, Some(&mut wvr));
+        pk.handle_key(KEY_LEFTCTRL, false, &mut focus, Some(&mut wvr));
+        assert!(wvr.recorded_keys().is_empty());
+    }
+
+    #[test]
+    fn chord_does_nothing_without_a_wayvr_server() {
+        let mut pk = PhysicalKeyboard::new(false);
+        let mut focus = KeyboardFocus::PhysicalScreen;
+        pk.handle_key::<Recorder>(KEY_LEFTCTRL, true, &mut focus, None);
+        pk.handle_key::<Recorder>(KEY_LEFTALT, true, &mut focus, None);
+        pk.handle_key::<Recorder>(KEY_ESC, true, &mut focus, None);
+        assert_eq!(focus, KeyboardFocus::PhysicalScreen);
+    }
+
+    const BTN_R: u16 = BTN_RIGHT;
+
+    #[test]
+    fn mouse_mode_queues_motion_buttons_and_wheel() {
+        let mut pk = PhysicalKeyboard::new(true);
+        let focus = KeyboardFocus::WayVR;
+        assert!(!pk.handle_mouse(EV_REL, REL_X, 5, focus));
+        assert!(!pk.handle_mouse(EV_REL, REL_Y, -3, focus));
+        assert!(!pk.handle_mouse(EV_KEY, BTN_R, 1, focus));
+        assert!(!pk.handle_mouse(EV_KEY, BTN_R, 0, focus));
+        assert!(!pk.handle_mouse(EV_REL, REL_WHEEL, 1, focus));
+        assert_eq!(
+            pk.take_mouse_events(),
+            [
+                PhysicalMouseEvent::Motion { dx: 5.0, dy: -3.0 },
+                PhysicalMouseEvent::Button { button: PhysicalButton::Right, pressed: true },
+                PhysicalMouseEvent::Button { button: PhysicalButton::Right, pressed: false },
+                PhysicalMouseEvent::Wheel { x: 0.0, y: WHEEL_NOTCH },
+            ]
+        );
+    }
+
+    #[test]
+    fn keyboard_only_mode_click_returns_to_desktop() {
+        let mut pk = PhysicalKeyboard::new(false);
+        let focus = KeyboardFocus::WayVR;
+        assert!(pk.handle_mouse(EV_KEY, BTN_LEFT, 1, focus));
+        assert!(pk.take_mouse_events().is_empty());
+    }
+
+    #[test]
+    fn mouse_ignored_while_desktop_has_focus() {
+        let mut pk = PhysicalKeyboard::new(true);
+        let focus = KeyboardFocus::PhysicalScreen;
+        assert!(!pk.handle_mouse(EV_KEY, BTN_LEFT, 1, focus));
+        assert!(!pk.handle_mouse(EV_REL, REL_X, 10, focus));
+        assert!(pk.take_mouse_events().is_empty());
+    }
+
+    #[test]
+    fn release_without_press_is_dropped_and_held_buttons_released_on_leave() {
+        let mut pk = PhysicalKeyboard::new(true);
+        let focus = KeyboardFocus::WayVR;
+        // Release of a button pressed before the grab never reaches WayVR.
+        pk.handle_mouse(EV_KEY, BTN_LEFT, 0, focus);
+        assert!(pk.take_mouse_events().is_empty());
+        // A button held when focus leaves gets a synthetic release.
+        pk.handle_mouse(EV_KEY, BTN_LEFT, 1, focus);
+        pk.take_mouse_events();
+        pk.release_mouse_buttons();
+        assert_eq!(
+            pk.take_mouse_events(),
+            [PhysicalMouseEvent::Button { button: PhysicalButton::Left, pressed: false }]
+        );
+    }
+}
