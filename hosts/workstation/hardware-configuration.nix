# Do not modify this file!  It was generated by ‘nixos-generate-config’
# and may be overwritten by future invocations.  Please make changes
# to /etc/nixos/configuration.nix instead.
{ config, lib, pkgs, modulesPath, ... }:

{
  imports =
    [ (modulesPath + "/installer/scan/not-detected.nix")
    ];

  boot.initrd.availableKernelModules = [ "xhci_pci" "nvme" "ahci" "uas" "usbhid" "usb_storage" "sd_mod" ];
  boot.initrd.kernelModules = [ ];
  boot.kernelModules = [ "kvm-amd" ];
  boot.extraModulePackages = [ ];
  boot.supportedFilesystems = [ "ntfs" ];

  fileSystems = {
    "/" = {
      device = "/dev/mapper/luks-a6074c99-c7c5-43a6-b15b-8d64317ab374";
      fsType = "xfs";
    };

    "/boot" = { 
      device = "/dev/disk/by-uuid/B8B7-26F4";
      fsType = "vfat";
      options = [ "fmask=0077" "dmask=0077" ];
    };

    /* Nix store on the 980 PRO (nvme1n1p1, LUKS + XFS), off the SATA disk that also
       holds swap. neededForBoot: the system can't start without its store. */
    "/nix" = {
      device = "/dev/mapper/store";
      fsType = "xfs";
      neededForBoot = true;
      options = [ "noatime" ];
    };

    /* ~/Development on the same NVMe (nvme1n1p2, LUKS + XFS). Ownership lives on the
       filesystem (setkeh:users on its top directory), not in mount options.
       From Windows: wsl --mount --bare, then cryptsetup + mount -t xfs in WSL. */
    "/home/setkeh/Development" = {
      device = "/dev/mapper/dev";
      fsType = "xfs";
      options = [ "noatime" ];
    };

    /* Foundry share on the NAS, over the bond-stor storage network. Mounted on first
       access so a NAS outage can't hold up boot. Read/write is decided on the server:
       ownership lives on the dataset, and the client sends setkeh's uid (1000). */
    "/home/setkeh/Foundry" = {
      device = "172.0.0.1:/mnt/MainPool/Foundry";
      fsType = "nfs";
      options = [ "rw" "nfsvers=4.2" "nconnect=8" "noatime" "_netdev" "noauto" "x-systemd.automount" ];
    };

    "/mnt/backup-disk" = {
      device = "/dev/disk/by-uuid/1ACEC9B8CEC98D07";
      fsType = "ntfs3";
      options = [ "uid=1000" "gid=100" "nofail" ];
    };

    /* "Storage Disk": NTFS on the 2 TB Crucial SATA SSD (sdb2). nofail so a mount
       problem can't hold boot in the emergency shell. */
    "/mnt/storage" = {
      device = "/dev/disk/by-uuid/B81652D2165290EC";
      fsType = "ntfs3";
      options = [ "uid=1000" "gid=100" "nofail" ];
    };

    /* Old OSX disk (HFS+, label StorageDisk, 1 TB WD on USB), mounted only to back it up before
       it's reformatted. Read-only: Linux can't safely write journaled HFS+, and the volume
       wasn't cleanly unmounted. nofail so an unplugged or bad disk can't stop boot. */
    "/mnt/airwallex-data" = {
      device = "/dev/disk/by-uuid/6eade72e-4bbf-3339-bcaf-f04c7500940e";
      fsType = "hfsplus";
      options = [ "ro" "uid=1000" "gid=100" "nofail" ];
    };

    "/mnt/winders" = {
      device = "/dev/disk/by-uuid/D250EE2650EE1151";
      fsType = "ntfs3";
      options = [ "uid=1000" "gid=100" "nofail" ];
    };

    /* For some Reason Clause does not work with skills in linux with symlinks like it does in WSL
    it some sort of directory protection to stop skills from re-Writing themselves while they are running.
    this fundamentally breaks the workflow. THis does not prevent that protection from working but prevents 
    the claude link startup check failing because the directory exists in two places via the link. */

    "/home/setkeh/.claude/skills" = {
      device = "/home/setkeh/SecondMind/AIOS/Skills";
      fsType = "none";
      options = [ "bind" ];
    };
  };

  boot.initrd.luks.devices = {
    "luks-a6074c99-c7c5-43a6-b15b-8d64317ab374" = {
      device = "/dev/disk/by-uuid/a6074c99-c7c5-43a6-b15b-8d64317ab374";
      bypassWorkqueues = true;
      allowDiscards = true;
    };

    /* NVMe (nvme1n1). Unlocked in the initrd with the root disk; a passphrase entered
     once is tried on these too (reusePassphrases), so matching passphrases mean one prompt. */
    store = {
      device = "/dev/disk/by-uuid/56748ea0-1432-4d98-9335-0a41bf7647a0";
      bypassWorkqueues = true;
      allowDiscards = true;
    };

    dev = {
      device = "/dev/disk/by-uuid/e6c8c375-dbbf-4684-afbb-f486d6e7d187";
      bypassWorkqueues = true;
      allowDiscards = true;
    };
  };

  swapDevices = [{
    device = "/dev/disk/by-partuuid/dd090197-b8da-4702-ab8a-a24fdb7149a8";
    randomEncryption = {
      enable = true;
      allowDiscards = true;
    };
    discardPolicy = "both"; 
  }];

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
  hardware.cpu.amd.updateMicrocode = lib.mkDefault config.hardware.enableRedistributableFirmware;
}
